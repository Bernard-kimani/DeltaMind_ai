# ---- Alpaca ----
# During pre-hackathon dev, use any paper account for testing — both tracks
# share this one pair, since ALPACA_API_KEY_TRACK4 below is unset.
# On Day 1 of the hackathon (Aug 28, 2026), submissions must score each
# track independently, so Track 1 and Track 4 need their OWN separate paper
# accounts. Create TWO brand-new paper accounts and set:
#   - ALPACA_API_KEY / ALPACA_SECRET_KEY          -> Track 1's account
#   - ALPACA_API_KEY_TRACK4 / ALPACA_SECRET_KEY_TRACK4 -> Track 4's account
# (agent_loop_manager.py passes the right pair to each track's subprocess
# automatically once both TRACK4 vars are set — see app/config.py's
# get_alpaca_credentials — no code changes needed at cutover.)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_API_KEY_TRACK4=
ALPACA_SECRET_KEY_TRACK4=
ALPACA_PAPER=true
ALPACA_TRADE_API_URL=https://paper-api.alpaca.markets
ALPACA_DATA_API_URL=https://data.alpaca.markets

# The Trading MCP Server (PyPI package `alpaca-mcp-server`) is launched via
# `uvx alpaca-mcp-server` — no local clone or path needed. mcp_client.py passes
# ALPACA_API_KEY/ALPACA_SECRET_KEY/ALPACA_PAPER_TRADE through to that
# subprocess automatically from the values above (ALPACA_PAPER maps to
# ALPACA_PAPER_TRADE — different var name because that's what the MCP
# server's own README specifies, separate from alpaca-py's `paper=` kwarg
# used by our own rest_client.py).

# ---- LLM ----
# provider = featherless | fireworks | anthropic
LLM_PROVIDER=featherless
LLM_MODEL=moonshotai/Kimi-K2-Instruct
LLM_FALLBACK_MODEL=deepseek-ai/DeepSeek-V3

FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional — only used if LLM_PROVIDER=anthropic (incurs API cost)
ANTHROPIC_API_KEY=

# ---- Database ----
# SQLite for the hackathon build. To move to Supabase later, swap this for
# your Supabase Postgres connection string (postgresql+psycopg2://...) —
# no code changes needed, models are provider-agnostic.
DATABASE_URL=sqlite:///./deltamind.db

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173
